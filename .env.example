# Personal agent settings. Every variable the application or compose reads is listed here.
# Deployments instead pass TELEGRAM_BOT_TOKEN, GATEWAY_API_KEY, and RESTIC_PASSWORD as
# <NAME>_FILE, and DATABASE_HOST, DATABASE_PORT, DATABASE_NAME, DATABASE_USER, and
# DATABASE_PASSWORD_FILE instead of DATABASE_URL (deploy/compose.production.yaml).
# Format: NAME=  # required|optional (default) - purpose. Never put real values here.

APP_ENV=development  # optional (production) - development | production
AF_REVISION=local  # optional (local) - revision baked into locally built images; CI sets the full commit
LOG_LEVEL=info  # optional (info) - debug | info | warning | error
DATABASE_URL=  # required - PostgreSQL URL for host-side tools, e.g. the local DB on DB_HOST_PORT
DB_POOL_MIN_SIZE=1  # optional (1) - worker connection pool minimum
DB_POOL_MAX_SIZE=5  # optional (5) - worker connection pool maximum

# Local Docker stack
POSTGRES_DB=personal_agent  # optional (personal_agent)
POSTGRES_USER=personal_agent  # optional (personal_agent)
POSTGRES_PASSWORD=  # required - generate a random local value
DB_HOST_PORT=54331  # optional (54331) - loopback port of the local database
WORKER_GATEWAY_URL=http://host.docker.internal:8360  # optional (same) - gateway URL as seen from the worker container
AGENT_HEALTH_PORT=8380  # optional (8380) - loopback port of the worker's health endpoint

# Worker
TELEGRAM_BOT_TOKEN=  # required (worker) - the assistant's own bot token from BotFather
TELEGRAM_ALLOWED_USER_IDS=  # required (worker) - comma-separated Telegram user IDs whose private chats are answered
GATEWAY_URL=http://127.0.0.1:8360  # required (worker) - llm-gateway base URL for host-side runs; compose overrides it
GATEWAY_API_KEY=  # required (worker) - this project's gateway key (development key locally)
REPLY_PROFILE=reply  # optional (reply) - gateway contract profile for replies; reply_stub is free
DEFAULT_TIMEZONE=Asia/Jakarta  # optional (Asia/Jakarta) - IANA timezone until the profile sets one
TURN_DEBOUNCE_SECONDS=2  # optional (2) - quiet time that closes a burst of messages into one turn
RECENT_WINDOW_TOKENS=6000  # optional (6000) - estimated token budget for earlier messages in each call
OFFLINE_NOTICE_AFTER_SECONDS=300  # optional (300) - wait after which a reply mentions the delay
DRAFT_INTERVAL_SECONDS=1  # optional (1) - least time between streamed draft updates on Telegram
HEALTH_HOST=127.0.0.1  # optional (127.0.0.1) - interface of the worker's health endpoint; the image sets 0.0.0.0
HEALTH_PORT=8080  # optional (8080) - port of the worker's health endpoint
TELEGRAM_API_URL=https://api.telegram.org  # optional (same) - Bot API base URL; only rehearsals with a fake Bot API change it

# Backups
BACKUP_DIR=  # required - host folder outside the repository for the encrypted backups, e.g. ~/.local/share/personal-agent/backups
RESTIC_PASSWORD=  # required - generate a long random value and keep a copy in a password manager; without it backups cannot be read

# Tests
TEST_DATABASE_URL=  # optional - disposable database for tests marked db; scripts/check requires it
GATEWAY_TEST_URL=  # optional - gateway for scripts/converse, e.g. http://127.0.0.1:8360
GATEWAY_TEST_API_KEY=  # optional - development key with a reply_stub profile on the stub model
