# Personal agent settings. Every variable the application or compose reads is listed here.
# Format: NAME=  # required|optional (default) - purpose. Never put real values here.

APP_ENV=development  # optional (production) - development | production
APP_REVISION=local  # optional (unknown) - revision the release sets
LOG_LEVEL=info  # optional (info) - debug | info | warning | error
DATABASE_URL=  # required - PostgreSQL URL for host-side tools, e.g. the local DB on DB_HOST_PORT
DB_POOL_MIN_SIZE=1  # optional (1) - worker connection pool minimum
DB_POOL_MAX_SIZE=5  # optional (5) - worker connection pool maximum

# Local Docker stack
POSTGRES_DB=personal_agent  # optional (personal_agent)
POSTGRES_USER=personal_agent  # optional (personal_agent)
POSTGRES_PASSWORD=  # required - generate a random local value
DB_HOST_PORT=54331  # optional (54331) - loopback port of the local database

# Tests
TEST_DATABASE_URL=  # optional - disposable database for tests marked db; scripts/check requires it
