#!/usr/bin/env bash
# Run pytest with the local test database from .env; arguments go to pytest. Database
# tests fail instead of skipping when the database is missing. The gateway contract test
# runs when PA_CONTRACT_IMAGE names a published gateway image.
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ -z "${TEST_DATABASE_URL:-}" && -f .env ]]; then
  value="$(sed -n 's/^TEST_DATABASE_URL=\([^ ]*\).*/\1/p' .env)"
  if [[ -n "$value" ]]; then
    export TEST_DATABASE_URL="$value"
  fi
fi
export REQUIRE_DB=1
exec uv run pytest "$@"
