#!/usr/bin/env bash
# Run pytest with the local test settings from .env (the test database, and the
# optional gateway contract target); arguments go to pytest. Database tests fail
# instead of skipping when the database is missing.
set -euo pipefail
cd "$(dirname "$0")/.."

for name in TEST_DATABASE_URL GATEWAY_TEST_URL GATEWAY_TEST_API_KEY; do
  if [[ -z "${!name:-}" && -f .env ]]; then
    value="$(sed -n "s/^${name}=\([^ ]*\).*/\1/p" .env)"
    if [[ -n "$value" ]]; then
      export "${name}=${value}"
    fi
  fi
done
export REQUIRE_DB=1
exec uv run pytest "$@"
