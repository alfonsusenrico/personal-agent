#!/usr/bin/env bash
# Run every project check, as the pre-push hook does: lock, format, lint, types, tests
# (database tests required), compose config, and OpenSpec validation.
set -euo pipefail
cd "$(dirname "$0")/.."

uv lock --check
uv run ruff format --check
uv run ruff check
uv run pyright
./scripts/test -q
docker compose config -q
openspec validate --all --no-interactive
