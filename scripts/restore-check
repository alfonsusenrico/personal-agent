#!/usr/bin/env bash
# Restore the newest backup into a throwaway PostgreSQL 16 on the Compose network and
# compare migrations and row counts with the live database. The throwaway container
# keeps its data in memory and is always removed.
set -euo pipefail
cd "$(dirname "$0")/.."

name="personal-agent-restore-check-$$"
network="$(docker inspect --format '{{range $name, $_ := .NetworkSettings.Networks}}{{$name}}{{end}}' "$(docker compose ps -q db)")"
trap 'docker rm --force "$name" >/dev/null 2>&1 || true' EXIT

docker run --detach --rm --name "$name" --network "$network" \
  --tmpfs /var/lib/postgresql/data \
  -e POSTGRES_HOST_AUTH_METHOD=trust -e POSTGRES_USER=restore -e POSTGRES_DB=restore \
  postgres:16-alpine >/dev/null
for _ in $(seq 1 30); do
  if docker exec "$name" pg_isready -U restore -d restore >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

docker compose run --rm --quiet-pull -T \
  -e "RESTORE_DATABASE_URL=postgresql://restore@${name}:5432/restore" \
  backup personal-agent-restore-check
