#!/usr/bin/env bash
# Review flagged replies and the newest backup's age; arguments go to the review
# (--summary, close <id> test|dismissed). Runs inside the running backup service,
# which has the database settings and restic. Without --summary it prints the
# owner's messages: agents run only --summary.
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ -z "$(docker compose ps --status running -q backup)" ]]; then
  echo "The backup service is not running; start it with: docker compose up -d backup" >&2
  exit 1
fi
exec docker compose exec -T backup personal-agent-review "$@"
