# Committed production defaults (no secrets, no host facts; contracts v1 §4).
APP_ENV=production
LOG_LEVEL=info
POSTGRES_DB=personal_agent
POSTGRES_USER=personal_agent
# The production gateway's API service on its Compose network.
GATEWAY_URL=http://api:8000
REPLY_PROFILE=reply
DEFAULT_TIMEZONE=Asia/Jakarta
TURN_DEBOUNCE_SECONDS=2
RECENT_WINDOW_TOKENS=6000
OFFLINE_NOTICE_AFTER_SECONDS=300
DRAFT_INTERVAL_SECONDS=1
